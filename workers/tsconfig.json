{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"],
      // Workers run in plain Node, where the real `server-only` package throws.
      // This mapping exists ONLY here; the Next.js build never reads this file,
      // so the browser-bundle guard stays fully in force.
      "server-only": ["./workers/stubs/server-only.ts"]
    }
  },
  "include": ["../src/**/*.ts", "./**/*.ts"]
}
