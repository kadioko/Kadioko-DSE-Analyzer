# ---------------------------------------------------------------------------
# Kadioko DSE Analyzer - environment variables
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Railway PostgreSQL connection string.
# Railway -> Postgres service -> Variables -> DATABASE_URL (use the PUBLIC url
# for local dev, the internal url for services deployed inside Railway).
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:5432/railway

# Email address allowed to reach /admin/*. Comma-separated list supported.
ADMIN_EMAIL=you@example.com

# Shared secret an operator presents at /admin/login, and the key the admin
# session cookie is signed with. Admin routes are disabled while this is empty.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Shared secret required by the scheduled ingestion endpoint.
# Send as: Authorization: Bearer <CRON_SECRET>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Active market data provider. One of: csv | dse_official | third_party
DATA_PROVIDER=csv

# Official / licensed DSE feed. Leave blank until a data licence is in place.
DSE_API_URL=
DSE_API_KEY=

# AI explanation layer (optional). The AI layer NEVER computes numbers,
# it only narrates values produced by the analytics engine.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Development-only source parsers stay off unless explicitly enabled.
# Unauthorised scraping must never be the production architecture.
ENABLE_DEV_PARSERS=false
